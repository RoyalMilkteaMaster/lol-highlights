# Copy this file to .env and set values for your machine.

# Optional API keys. YouTube falls back to yt-dlp when no key is provided.
ROBOFLOW_API_KEY=
YOUTUBE_API_KEY=

# MySQL 8.x
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lol_crawler
MYSQL_PASSWORD=
MYSQL_DB=lol_highlight

# Optional Leaguepedia proxy pool.
LEAGUEPEDIA_USE_PROXY=0

# Windows data locations. Forward slashes avoid escaping issues.
VIDEO_DIR=C:/lol-highlights-data/videos
OUTPUT_DIR=C:/lol-highlights-data/output

# Leave empty when ffmpeg and ffprobe are already on PATH.
FFMPEG_BIN=
