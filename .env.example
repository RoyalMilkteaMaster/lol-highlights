# 複製成 .env 再填值（.env 已在 .gitignore，不會被 commit）。
# 跑 .\setup.ps1 會自動產生這個檔，一般不需要手改。

# ── MySQL 8.x（setup.ps1 會建立帳號並填入隨機密碼）──────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lol_app
MYSQL_PASSWORD=
MYSQL_DB=lol_highlight

# ── 直播來源（可選，但沒有就【無法即時接直播自動剪】，只能手動餵影片）──────
# YouTube Data API v3 key：LCK / LCP 直播偵測用。
#   取得：https://console.cloud.google.com/apis/credentials -> 建立憑證 -> API 金鑰
#   留空 -> fallback 到 yt-dlp（較慢、較不穩）。
YOUTUBE_API_KEY=
# LPL（Bilibili）不用 key：用 Firefox 登入 bilibili.com，系統自動讀登入 cookie。

# ── 訓練用（一般使用者不需要）──────────────────────────────────────────────
ROBOFLOW_API_KEY=

# ── 路徑（用 / 不用 \，避免跳脫問題）─────────────────────────────────────
VIDEO_DIR=C:/lol-highlights/videos
OUTPUT_DIR=C:/lol-highlights/output
# ffmpeg.exe + ffprobe.exe 所在資料夾；留空代表已在 PATH
FFMPEG_BIN=
# lol-env 的 python.exe（setup.ps1 自動填；start.bat / check_env.bat 靠這行找 Python）
LOL_ENV_PYTHON=

# ── 其他 ────────────────────────────────────────────────────────────────────
LEAGUEPEDIA_USE_PROXY=0
